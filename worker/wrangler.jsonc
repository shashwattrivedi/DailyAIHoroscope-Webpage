{
  "name": "dailyaihoroscope-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "HOROSCOPES", "id": "0ae329380abe4bb7ba3cc93d77634c9b" }
  ],
  // Public bucket with the published day files (data/YYYY-MM-DD.json), served by the CDN.
  "r2_buckets": [
    { "binding": "DATA", "bucket_name": "dailyaihoroscope-data" }
  ],
  // Settings only. Keys and passwords are secrets: `npx wrangler secret put NAME`
  // (see .dev.vars.example), never in this file.
  "vars": {
    // The model that writes the lines (Workers AI), and options passed with each request.
    // Gemma 4 thinks before answering unless told not to, and then runs out of tokens.
    "MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "MODEL_OPTIONS": { "chat_template_kwargs": { "enable_thinking": false } },
    // The arena (arena.js): every model writes all 12 lines from the same prompt, and each
    // sign shows one model's line, shared equally. Leave a model out to stop using it;
    // MODEL is the fallback. format "responses": the model takes OpenAI's Responses input.
    "MODELS": [
      { "id": "@cf/google/gemma-4-26b-a4b-it", "options": { "chat_template_kwargs": { "enable_thinking": false } } },
      { "id": "@cf/meta/llama-3.3-70b-instruct-fp8-fast" },
      { "id": "@cf/openai/gpt-oss-120b", "format": "responses", "options": { "reasoning": { "effort": "low" } } },
      { "id": "@cf/mistralai/mistral-small-3.1-24b-instruct" }
    ],
    "SITE": "https://dailyaihoroscope.com",
    // Platforms to post to, in this order: bluesky, x, facebook, instagram, instagram_story, reddit.
    // Each run posts what fits in 50 requests, so the first ones post soonest.
    "SOCIAL": "facebook,instagram,instagram_story,bluesky",
    // "true": only log what would be posted. Set to "false" to post for real.
    "SOCIAL_DRY_RUN": "false",
    // "false": post only the X cover post, not the 12 sign replies. X bills each post
    // (about $0.015 without a link): the thread is about $6 a month, the cover alone $0.45.
    "X_THREAD": "true",
    "REDDIT_SUBREDDIT": "",
    "META_GRAPH_VERSION": "v23.0",
    // The repo whose Deploy action the Worker starts each day (needs the GH_DISPATCH_TOKEN secret).
    "GITHUB_REPO": "shashwattrivedi/DailyAIHoroscope-Webpage",
    // Private dashboard (report.js); open it once with ?key=<DASHBOARD_KEY secret>.
    "DASHBOARD_URL": "https://dailyaihoroscope-api.shashwatdevai.workers.dev/dashboard",
    // Google Analytics property for the daily report (also needs the GA_SERVICE_ACCOUNT secret).
    "GA_PROPERTY_ID": "560068162"
  },
  // Problem emails go to the ALERT_TO secret, which must be a verified Email Routing destination.
  "send_email": [{ "name": "ALERT_EMAIL" }],
  // Two crons (the Free plan allows 5 per account). 10:00 UTC, when a new date starts
  // (00:00 in UTC+14): writes and publishes it, then starts the site build; if this run
  // fails, the first request for the date writes it (see fetch()). Every 10 minutes from
  // 12:00 to 13:50 UTC: shares it on social media, as much as fits in each run's 50
  // requests. 14:00 UTC: last try, then the report. See scheduled() in index.js.
  "triggers": { "crons": ["0 10,14 * * *", "*/10 12,13 * * *"] }
}
