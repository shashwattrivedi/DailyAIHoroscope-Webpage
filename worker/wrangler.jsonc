{
  "name": "dailyaihoroscope-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "HOROSCOPES", "id": "0ae329380abe4bb7ba3cc93d77634c9b" }
  ],
  // Public bucket with the published day files (data/YYYY-MM-DD.json), served by the CDN.
  "r2_buckets": [
    { "binding": "DATA", "bucket_name": "dailyaihoroscope-data" }
  ],
  "vars": {
    "MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  // Daily at 10:00 UTC, when a new date starts (00:00 in UTC+14): writes and publishes it.
  // If this run fails, the first request for the date writes it (see fetch()).
  "triggers": { "crons": ["0 10 * * *"] }
}
