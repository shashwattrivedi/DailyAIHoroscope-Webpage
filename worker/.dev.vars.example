# Copy to .dev.vars for local testing (git ignores .dev.vars). For the deployed Worker,
# set each one as a secret instead, in your own terminal:
#   npx wrangler secret put BLUESKY_APP_PASSWORD
# Leave out any platform you don't use, or remove it from SOCIAL in wrangler.jsonc.

# GitHub fine-grained token, only this repo, permission Actions: Read and write.
# The Worker uses it to start the daily site build.
GH_DISPATCH_TOKEN=

# Where problem emails go (a verified Cloudflare Email Routing destination).
ALERT_TO=

# Private dashboard at /dashboard: open it once with ?key=<this>.
DASHBOARD_KEY=

# Google Analytics Data API for the daily report: the JSON key of a service account that
# has Viewer access to the GA property (set GA_PROPERTY_ID in wrangler.jsonc).
GA_SERVICE_ACCOUNT=

# Bluesky: Settings > Privacy and security > App passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# X: developer.x.com app with Read and write, "Keys and tokens" tab
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Facebook Page and Instagram (Business account linked to the Page): long-lived Page token
# with pages_show_list, pages_read_engagement, pages_manage_posts, instagram_basic and
# instagram_content_publish. How to make one: "Renewing the Meta token" in the README.
META_PAGE_ID=
META_PAGE_TOKEN=
INSTAGRAM_USER_ID=

# Reddit: reddit.com/prefs/apps, "script" app (set REDDIT_SUBREDDIT in wrangler.jsonc)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
